{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    // Renderer code runs in the browser/DOM context.
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    // Shared types are consumed by both main and renderer.
    "src/shared/**/*.ts",
    // Renderer/editor tests and shared smoke test run under happy-dom.
    // Main-process tests (tests/unit/main/**) are intentionally excluded here;
    // they live in tsconfig.node.json to prevent accidental DOM usage in Node code.
    "tests/unit/editor/**/*.ts",
    "tests/unit/editor/**/*.tsx",
    "tests/unit/store/**/*.ts",
    "tests/unit/hooks/**/*.ts",
    "tests/unit/components/**/*.tsx",
    "tests/unit/smoke.test.ts",
    // Export tests run in happy-dom (renderer-side buildExportHtml).
    "tests/unit/export/**/*.ts"
  ]
}
