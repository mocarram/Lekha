{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"],
    "noEmit": true
  },
  "include": [
    // Main-process and preload code: Node-only, no DOM lib.
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    // Shared types are consumed by both main and renderer.
    "src/shared/**/*.ts",
    // Main-process unit tests run under the Node environment.
    "tests/unit/main/**/*.ts",
    // Template listing test uses Node fs (main-process helper).
    "tests/unit/templates/listTemplates.test.ts",
    // Theme unit tests that run under the Node environment.
    "tests/unit/themes/settingsTheme.test.ts",
    "tests/unit/themes/menuTheme.test.ts",
    // Build-hook unit tests run under the Node environment.
    "tests/unit/build/**/*.ts",
    // NOTE: E2E specs are intentionally NOT here. They are typechecked in
    // tsconfig.e2e.json because their browser-side page.evaluate() callbacks
    // need the DOM lib, which this Node-only project deliberately omits.
    // Build/tooling configs live in Node.
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
